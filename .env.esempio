# Copia questo file in .env. Senza, la chat funziona lo stesso ma puo' solo
# rieseguire i moduli che hanno gia' un programma in compilatori/ - che e'
# esattamente la parte che non costa niente.

# --- se la chiave ce l'hai gia' in un altro progetto -------------------------
# Basta puntarci: resta dov'e', non si copia in un secondo posto da tenere
# aggiornato. Vengono riconosciuti anche i nomi diffusi (OPENROUTER_API_KEY,
# DEEPSEEK_API_KEY, OPENAI_API_KEY, OPENAI_BASE_URL, ...).
# QUADRA_ENV=E:\percorso\del\progetto\.env

# --- oppure si scrive qui ----------------------------------------------------
# L'endpoint si scrive senza /chat/completions in fondo.
# QUADRA_BASE_URL=https://api.deepseek.com/v1
# QUADRA_CHIAVE=
# QUADRA_MODELLO=

# Il tetto va tenuto alto: con un tetto basso e ragionamento alto il modello
# consuma tutto il budget pensando e restituisce zero caratteri.
QUADRA_TETTO_GETTONI=393216
